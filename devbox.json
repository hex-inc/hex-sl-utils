{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": {
    "nodejs": "24",
    "oxfmt": "0.59.0",
    "oxlint": "1.75.0",
    "python": {
      "version": "3.14",
      "disable_plugin": true
    },
    "uv": "0.12.1"
  },
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_PYTHON_PREFERENCE": "only-system"
  },
  "shell": {
    "scripts": {
      "setup": ["uv sync --locked --all-packages", "pnpm install --frozen-lockfile"],
      "check": [
        "uv run --locked --all-packages ruff check .",
        "uv run --locked --all-packages ruff format --check .",
        "uv run --locked --all-packages pyright",
        "uv run --locked --all-packages rumdl check .",
        "uv run --locked --all-packages rumdl fmt --check .",
        "pnpm --recursive --if-present run check",
        "oxlint . --deny-warnings --no-error-on-unmatched-pattern",
        "oxfmt --check --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,json,jsonc}'"
      ],
      "format": [
        "uv run --locked --all-packages ruff check --fix .",
        "uv run --locked --all-packages ruff format .",
        "uv run --locked --all-packages rumdl fmt .",
        "oxlint . --fix --deny-warnings --no-error-on-unmatched-pattern",
        "oxfmt --write --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,json,jsonc}'"
      ],
      "test": ["uv run --locked --all-packages pytest"],
      "test-cov": [
        "uv run --locked --all-packages pytest --cov=packages --cov-report=term-missing --cov-report=xml"
      ],
      "build": ["uv build --all-packages --no-sources"],
      "verify": ["devbox run verify:schema", "devbox run verify:vendoring"],
      "smoke-test": ["uv run --locked --all-packages python scripts/smoke_test_packages.py \"$@\""],
      "ci": [
        "devbox run check",
        "devbox run test",
        "devbox run verify",
        "devbox run build",
        "devbox run smoke-test"
      ],
      "build:schema": ["uv run --locked --all-packages python scripts/schema/generate_schema.py"],
      "verify:schema": [
        "uv run --locked --all-packages python scripts/schema/check_generated_schema.py"
      ],
      "build:vendoring": [
        "uv run --locked --all-packages python scripts/vendoring/vendor_sqlglot.py"
      ],
      "verify:vendoring": [
        "uv run --locked --all-packages python scripts/vendoring/check_vendored_sqlglot.py"
      ]
    }
  }
}
