{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "nodejs": "24",
    "jdk": "22",
    "libpq": "18.4",
    "oxfmt": "0.59.0",
    "oxlint": "1.75.0",
    "python": {
      "version": "3.14",
      "disable_plugin": true
    },
    "uv": "0.12.5",
    "just": "latest"
  },
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_PYTHON_PREFERENCE": "only-system"
  }
}
