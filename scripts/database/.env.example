# Copy this file to scripts/database/.env and fill in the credentials for the
# cloud dialects you want to test. The cloud test runner loads that local file
# when it is present; it is intentionally gitignored.
#
# BigQuery accepts the service-account JSON as one shell-quoted line. Keep
# escaped newlines (\\n) inside the private_key value rather than literal ones.
TEST_BIG_QUERY_PROJECT_ID=""
TEST_BIG_QUERY_SERVICE_ACCOUNT='{"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"","client_id":"","token_uri":"https://oauth2.googleapis.com/token"}'

# Redshift
TEST_REDSHIFT_ENDPOINT=""
TEST_REDSHIFT_PORT="5439"
TEST_REDSHIFT_USERNAME=""
TEST_REDSHIFT_DB=""
TEST_REDSHIFT_PASSWORD=""

# Snowflake
TEST_SNOWFLAKE_ACC=""
TEST_SNOWFLAKE_USERNAME=""
TEST_SNOWFLAKE_PRIVATE_KEY=""
TEST_SNOWFLAKE_DB=""
TEST_SNOWFLAKE_WH=""
TEST_SNOWFLAKE_ROLE=""
